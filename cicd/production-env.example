APP_ENV=production
APP_NAME=AgentHub
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://your-frontend-domain.com

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

LLM_PROVIDER=aicredits
AGENT_MAX_ITERATIONS=4
LLM_MODEL_DEFAULT=google/gemini-2.5-flash
LLM_MODEL_FAST=google/gemini-2.5-flash
LLM_MODEL_SMART=deepseek/deepseek-v4-pro
LLM_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b
LLM_MODEL_CHEAP=openai/gpt-3.5-turbo-0613
LLM_MODEL_EXPERIMENTAL=gpt-5-mini
AICREDITS_BASE_URL=
AICREDITS_API_KEY=

SERPER_API_KEY=
TAVILY_API_KEY=
ENABLE_TAVILY_FALLBACK=false
